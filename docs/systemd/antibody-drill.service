# Antibody daily drill (docs/drill.md). A systemd service template: generic placeholders only, no host
# details. Install to /etc/systemd/system/antibody-drill.service, fill in <install-dir> and <user>, then
# `systemctl daemon-reload`. Run by antibody-drill.timer once a day; `--dry-run` only reads the guards.
#
# Needs, in <install-dir>: the built binary (target/release/antibody-services), .env (SEPOLIA_RPC,
# SEPOLIA_TX_RPC, BASE_SEPOLIA_RPC, RELAYER_EVM_KEY), .secrets/near/<account>.json for the drill's accounts
# and .secrets/sepolia_deployer.json for the base deployer.
#
# The kill switch: `touch <install-dir>/target/drill/drill.disabled` (or set ANTIBODY_DRILL_OFF in the
# environment file) to make every run do nothing and say so.

[Unit]
Description=Antibody daily drill (the one moment on testnet, a fresh fixture)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=<user>
WorkingDirectory=<install-dir>
EnvironmentFile=<install-dir>/.env
# The drill spends from the operator's keys; it never needs elevated privileges.
ExecStart=<install-dir>/target/release/antibody-services drill --results-dir <install-dir>/docs/results
# A drill waits for the light client to reach a fresh anchor (~16 min) plus the moment: an hour is plenty.
TimeoutStartSec=3600
Nice=10
# Hardening (generic): the drill writes only under its work dir and the results dir.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target

# ---- secrets and local configuration: never committed ----
.env
.env.*
!.env.example
.secrets/
*.key
*.pem
*.secret
**/keys/*.json

# ---- never-public material ----
# Research notes (may contain third-party analysis), internal reports and raw measurement logs stay
# local. Public, sanitized evidence lives in docs/.
research/
report/
reports/
measurements/
# Briefs, milestone/daily reports and their tooling stay private (outside the repository).
brief*.md
*_brief*.md
daily/
scripts/report_to_html.py
# Arena: hidden-bug PoCs live in a separate private location, never in this repository.
arena-private/
**/arena-private/
*.private.*

# ---- third-party clones (read-only references); only our build patches are tracked ----
third_party/*
!third_party/patches/
third_party/patches/**/tests/
third_party/patches/**/target/

# ---- build outputs and caches ----
target/
**/target/
node_modules/
**/node_modules/
__pycache__/
*.pyc
contracts/evm/out/
contracts/evm/cache/
contracts/evm/broadcast/
*.log

# ---- large or regenerable local data ----
witnesses/
fixtures/local/
*.anvil-state.json
.tools/

# generated by scripts/demo/check_fixtures.py
fixtures/**/*.wasm.*.json
third_party/patches/**/.github/
third_party/patches/**/.cargo-ok
.antibody/

# Antibody local configuration. Copy to .env (git-ignored). Scripts read these and never print values.

# --- Ethereum testnets (archive + eth_getProof needed for witnesses older than the public proof window) ---
SEPOLIA_RPC=
BASE_SEPOLIA_RPC=

# --- v0.3 historical-replay measurements only: >= 3 Ethereum MAINNET archive RPCs (read-only) ---
ETH_RPC_1=
ETH_RPC_2=
ETH_RPC_3=

# Testnet-only keys are generated into .secrets/ (git-ignored); fund the printed addresses instead of
# sharing keys. Set these only to use your own testnet keys:
# SEPOLIA_DEPLOYER_KEY=
# NEAR_ACCOUNT_ID=
# NEAR_PRIVATE_KEY=

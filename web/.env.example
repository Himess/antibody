# The Antibody API (antibody-services api), over HTTPS. Locally: http://127.0.0.1:8787 (or the sandbox's).
NEXT_PUBLIC_API_BASE=https://api.antibody.example
# This site's own origin (OG images, canonical URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_NEAR_NETWORK=testnet
# NEAR RPCs the browser uses for checks and the try, tried in order (comma-separated). No secret ever goes here.
NEXT_PUBLIC_NEAR_RPCS=https://rpc.testnet.fastnear.com,https://test.rpc.fastnear.com,https://rpc.testnet.near.org
NEXT_PUBLIC_NEAR_ARCHIVAL_RPCS=https://archival-rpc.testnet.fastnear.com,https://archival-rpc.testnet.near.org
NEXT_PUBLIC_SEPOLIA_RPCS=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_BASE_SEPOLIA_RPCS=https://base-sepolia-rpc.publicnode.com
